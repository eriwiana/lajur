#!/bin/sh
# Guard rail, not a control: --no-verify bypasses it. Merge via PR, push feature branches.
set -e
cd "$(git rev-parse --show-toplevel)"
while read -r _ _ remote_ref _; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: direct push to main refused. Open a PR." >&2
    exit 1
  fi
done
npm run --silent typecheck
npm test --silent
